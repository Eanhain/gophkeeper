# App
APP_NAME=gophkeeper
APP_VERSION=1.0.0
# HTTP settings
HTTP_PORT=8080
HTTP_USE_PREFORK_MODE=false
LOG_LEVEL=debug
# PG
PG_POOL_MAX=2
PG_URL=postgres://db_user:s3cret@localhost:5432/gophkeeper
# JWT (обязательно, без дефолта — fail early)
JWT_SECRET=test-jwt-secret-do-not-use-in-production
# TLS (обязательно — сервер не запустится без сертификатов)
# Для разработки: openssl req -x509 -newkey rsa:4096 -keyout key.pem -out cert.pem -days 365 -nodes -subj '/CN=localhost'
TLS_CERT_FILE=./certs/cert.pem
TLS_KEY_FILE=./certs/key.pem
# Swagger
SWAGGER_ENABLED=true
