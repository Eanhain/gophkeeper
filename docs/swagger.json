                },
                "mime_type": {
                    "type": "string",
                    "example": "application/x-pem-file"
                }
            }
        },
        "request.CardSecret": {
            "type": "object",
            "properties": {
                "brand": {
                    "type": "string",
                    "example": "Visa"
                },
